<Project>

  <!-- Common settings for all the projects (libraries, tests, samples and benchmarks).
       The package settings of the libraries are in src/Directory.Build.props, that imports this file.
       The package versions are in Directory.Packages.props (Central Package Management). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- the build has no warnings: a new warning is an error.
         The NuGet audit warnings (a vulnerability published for a package) stay warnings, so they do not break the build of an unrelated change. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Authors>Federico Mazzanti</Authors>
    <Copyright>Copyright (c) 2022-2026 Federico Mazzanti</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fmazzant/TinyCsv</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fmazzant/TinyCsv</PackageProjectUrl>
    <Deterministic>true</Deterministic>
    <!-- only the libraries in src/ are packages -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
