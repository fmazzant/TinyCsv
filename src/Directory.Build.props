<Project>

  <!-- The settings of all the projects (language version, nullable, authors, repository): ../Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Common settings for all the packages in src/ -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Only a pointer: the full history is in CHANGELOG.md -->
    <PackageReleaseNotes>Breaking changes in 4.0.0: see "Migrating to 4.0" in the README. Full changelog: https://github.com/fmazzant/TinyCsv/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- SourceLink (included in the .NET SDK) and symbol packages (the deterministic build is in ../Directory.Build.props) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package validation: checks that the API is consistent across the target frameworks.
         After the 4.0.0 release, enable the comparison with the released version, to catch accidental breaking changes in 4.x:
           <PackageValidationBaselineVersion>4.0.0</PackageValidationBaselineVersion> -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
    <!-- Every package has its own short README.md (next to the .csproj), shown on nuget.org -->
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
