<Project Sdk="Microsoft.NET.Sdk">

  <!-- The common package settings (license, readme, icon, SourceLink, symbols) are in src/Directory.Build.props -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net462;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Mafesoft.TinyCsv</PackageId>
    <Product>TinyCsv</Product>
    <Title>Mafesoft.TinyCsv</Title>
    <Version>4.0.2</Version>
    <Description>TinyCsv is a .NET library to read and write CSV data in an easy way: strongly typed models with lambda columns, attributes or class maps, header mapping, delimiter detection, per-row error handling, records without a model and streaming async read and write.</Description>
    <PackageTags>csv;csv-parser;csv-reader;csv-writer;rfc4180;tsv;dotnet</PackageTags>
  </PropertyGroup>

  <!-- Span support where it is not built-in -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" />
    <!-- IAsyncEnumerable<T> / IAsyncDisposable: the same async API on every target framework -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyCsv.Tests" />
  </ItemGroup>

</Project>
