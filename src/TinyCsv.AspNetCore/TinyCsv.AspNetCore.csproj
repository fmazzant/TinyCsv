<Project Sdk="Microsoft.NET.Sdk">

  <!-- The common package settings (license, readme, icon, SourceLink, symbols) are in src/Directory.Build.props -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Mafesoft.TinyCsv.AspNetCore</PackageId>
    <Product>TinyCsv.AspNetCore</Product>
    <Title>Mafesoft.TinyCsv.AspNetCore</Title>
    <Version>4.2.0</Version>
    <Description>Mafesoft.TinyCsv in ASP.NET Core: dependency injection (typed singletons, named instances, ITinyCsvFactory) and, on .NET 8+, CSV results for the minimal APIs, IFormFile uploads, MVC input and output formatters and ProblemDetails for bad data.</Description>
    <PackageTags>csv;csv-parser;csv-reader;csv-writer;rfc4180;tsv;dotnet;aspnetcore;dependency-injection;minimal-api;mvc;formatter</PackageTags>
  </PropertyGroup>

  <!-- netstandard2.0: only the abstractions are used: IServiceCollection, TryAddSingleton -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- .NET 8+: the ASP.NET Core shared framework, for the CSV results of the minimal APIs, IFormFile and the MVC formatters -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyCsv\TinyCsv.csproj" />
  </ItemGroup>

</Project>
