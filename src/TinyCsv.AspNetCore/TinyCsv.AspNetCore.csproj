<Project Sdk="Microsoft.NET.Sdk">

  <!-- The common package settings (license, readme, icon, SourceLink, symbols) are in src/Directory.Build.props -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Mafesoft.TinyCsv.AspNetCore</PackageId>
    <Product>TinyCsv.AspNetCore</Product>
    <Title>Mafesoft.TinyCsv.AspNetCore</Title>
    <Version>4.0.1</Version>
    <Description>Registers Mafesoft.TinyCsv in the ASP.NET Core dependency injection: typed singletons, named instances (keyed services on .NET 8+) and ITinyCsvFactory.</Description>
    <PackageTags>csv;csv-parser;csv-reader;csv-writer;rfc4180;tsv;dotnet;aspnetcore;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- only the abstractions are used: IServiceCollection, TryAddSingleton, AddKeyedSingleton (.NET 8+) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyCsv\TinyCsv.csproj" />
  </ItemGroup>

</Project>
