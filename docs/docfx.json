{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "TinyCsv/TinyCsv.csproj",
            "TinyCsv.Extensions/TinyCsv.Extensions.csproj",
            "TinyCsv.AspNetCore/TinyCsv.AspNetCore.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      },
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "TinyCsv",
      "_appTitle": "TinyCsv",
      "_appFooter": "TinyCsv &copy; Federico Mazzanti. Released under the MIT License.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/fmazzant/TinyCsv",
        "branch": "master"
      },
      "pdf": false
    },
    "sitemap": {
      "baseUrl": "https://fmazzant.github.io/TinyCsv"
    }
  }
}
