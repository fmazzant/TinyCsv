<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, whatever is configured on the machine: the same packages locally and in CI
     (and Central Package Management, see Directory.Packages.props, requires a single source or a source mapping) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
